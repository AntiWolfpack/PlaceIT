# PostgreSQL connection string from Neon, Supabase, or a local PostgreSQL server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# API server and frontend development defaults.
PORT=3000
VITE_PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://localhost:3000

# PayFast sandbox credentials. Keep real credentials in .env only.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=your-sandbox-merchant-id
PAYFAST_MERCHANT_KEY=your-sandbox-merchant-key
PAYFAST_PASSPHRASE=your-sandbox-passphrase
PAYFAST_RETURN_URL=http://localhost:5173/orders
PAYFAST_CANCEL_URL=http://localhost:5173/orders
# PayFast must be able to reach this URL; use a public HTTPS API URL, not localhost.
PAYFAST_NOTIFY_URL=https://your-public-api-host/api/payfast/notify

# Supabase Auth for vendor accounts. The VITE_ values are public client config;
# never put a Supabase service-role key in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Generate a long random value and keep it unchanged: existing pickup codes
# depend on it for encrypted receipt delivery.
PICKUP_CODE_SECRET=replace-with-a-long-random-secret

# Resend email receipts and customer status updates.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=PlaceIT <orders@your-verified-domain.example>

# WhatsApp Business Cloud API; create and approve a template with four body
# variables: order number, customer first name, item summary, order total.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ORDER_TEMPLATE=placeit_new_order
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
